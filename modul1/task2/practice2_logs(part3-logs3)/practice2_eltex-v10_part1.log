shell=/bin/bash
$ groupadd practice2_group
$ usermod -aG practice2_group user1
$ usermod -aG practice2_group user2
$ usermod -aG practice2_group user3
$ grep practice2_group /etc/group
practice2_group:x:1004:user1,user2,user3
$ bash -c groups user1; groups user2; groups user3
user1 : user1 practice2_group
user2 : user2 users practice2_group
user3 : user3 users practice2_group
